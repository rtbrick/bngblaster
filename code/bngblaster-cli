import sys
import socket
import os
import json
import ast
import re

def error(*args, **kwargs):
    """print error and exit"""
    print(*args, file=sys.stderr, **kwargs)
    sys.exit(1)


def usage():
    error("""BNG Blaster CLI Tool

The CLI tool is a simple control socket client
for interactive communication with the BNG Blaster.

{c} <socket> <command> [arguments]

Examples:
    {c} run.sock session-info session-id 1
    {c} run.sock interface-topology
    {c} run.sock interface-topology interface eth0
    {c} run.sock igmp-join session-id 1 group 239.0.0.1 source1 1.1.1.1 source2 2.2.2.2 source3 3.3.3.3
    {c} run.sock igmp-info session-id 1
    {c} run.sock l2tp-csurq tunnel-id 1 sessions [1,2]
""".format(c=sys.argv[0]))
    sys.exit(1)


def argument_value(arg, arg_type=None):
    if arg_type == "string":
        # string arguments like "username 12345" stay strings
        return arg
    if arg_type == "array":
        try:
            return json.loads(arg)
        except ValueError:
            try:
                return ast.literal_eval(arg)
            except (ValueError, SyntaxError):
                return arg
    if re.fullmatch(r"-?[0-9]+", arg):
        # integer arguments like "session-id 1"
        return int(arg)
    if re.fullmatch(r"-?[0-9]+\.[0-9]+", arg):
        # decimal arguments like "pps 0.5"
        return float(arg)
    if arg in ("true", "True"):
        return True
    if arg in ("false", "False"):
        return False
    if arg.startswith("[") or arg.startswith("{"):
        # list arguments like "sessions [1,2]"
        try:
            return json.loads(arg)
        except ValueError:
            try:
                return ast.literal_eval(arg)
            except (ValueError, SyntaxError):
                pass
    # string arguments like "group 239.0.0.1"
    return arg


def build_request(argv, arg_types=None):
    request = {}
    request["command"] = argv[2]
    if len(argv) > 3:
        if (len(argv) - 3) % 2:
            raise ValueError("argument %s without value" % argv[-1])
        request["arguments"] = {}
        for i in range(3, len(argv), 2):
            arg_type = (arg_types or {}).get(argv[i])
            request["arguments"][argv[i]] = argument_value(argv[i+1], arg_type)
    return request


def argument_types(socket_path, command):
    """Argument types of the command as announced by the commands
    request, empty if not available (older versions)."""
    try:
        data = send_request(socket_path, {"command": "commands"})
        for cmd in data.get("commands", []):
            if cmd.get("command") == command:
                return {arg["name"]: arg["type"] for arg in cmd.get("arguments", [])
                        if isinstance(arg, dict)}
    except (AttributeError, KeyError, TypeError):
        pass
    return {}


def send_request(socket_path, request):
    if os.path.exists(socket_path):
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            client.connect(socket_path)
            client.send(json.dumps(request).encode('utf-8'))
            # Decode once at the end, as a multi-byte UTF-8
            # character can be split between two reads.
            data = bytearray()
            while True:
                junk = client.recv(65536)
                if junk:
                    data += junk
                else:
                    break
            return json.loads(data.decode('utf-8'))
        except Exception as e:
            error(e)
        finally:
            client.close()
    else:
        error("socket %s not found" % socket_path)


def main():
    """main function"""
    if(len(sys.argv)) < 3:
        usage()
    if sys.argv[2] == "help":
        usage()

    socket_path = sys.argv[1]
    arg_types = None
    if len(sys.argv) > 3:
        arg_types = argument_types(socket_path, sys.argv[2])
    try:
        request = build_request(sys.argv, arg_types)
    except Exception as e:
        error("invalid command: %s" % e)
    #print(json.dumps(request).encode('utf-8'))
    data = send_request(socket_path, request)

    if data.get("status") != "ok":
        # Error replies have no command specific content.
        print(json.dumps(data, indent=4))
    elif sys.argv[2] == "commands":
        for cmd in data["commands"]:
            arguments = []
            for arg in cmd.get("arguments", []):
                if isinstance(arg, dict):
                    arg_type = arg["type"]
                    if "sub-type" in arg:
                        arg_type = "%s<%s>" % (arg_type, arg["sub-type"])
                    arguments.append("%s:%s" % (arg["name"], arg_type))
                else:
                    # older versions return plain argument names
                    arguments.append(str(arg))
            print("%s [%s]" % (cmd["command"], "|".join(arguments)))
    elif sys.argv[2] == "interface-topology":
        for interface in data["interfaces"]:
            print("interface: %s" % interface["name"])
            print("  io-mode: %s" % interface["io-mode"])
            print("  numa-node: %s" % interface["numa-node"])
            print("  local-cpuset: %s" % interface["local-cpuset"])
            print("  rx-auto-cpuset: %s" % interface["rx-auto-cpuset"])
            for thread in interface["rx-threads"]:
                print("  rx-thread id=%s cpu=%s source=%s queue=%s active=%s stopped=%s" % (
                    thread["id"], thread["selected-cpu"], thread["cpu-source"],
                    thread.get("queue", "N/A"), thread["thread-active"], thread["thread-stopped"]))
            print("  tx-auto-cpuset: %s" % interface["tx-auto-cpuset"])
            for thread in interface["tx-threads"]:
                print("  tx-thread id=%s cpu=%s source=%s queue=%s active=%s stopped=%s" % (
                    thread["id"], thread["selected-cpu"], thread["cpu-source"],
                    thread.get("queue", "N/A"), thread["thread-active"], thread["thread-stopped"]))
    else:
        print(json.dumps(data, indent=4))


if __name__ == "__main__":
    main()
